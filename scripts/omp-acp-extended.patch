+	/** Withdraw one owner-scoped steer. False means it already left the pending queue. */
+	withdrawSteeringMessage(message: AgentMessage): boolean {
+		let queued = this.#steeringQueue.includes(message);
+		this.#steeringQueue = this.#steeringQueue.filter(item => item !== message);
+		const claim = this.#queuedMessageClaims.steering;
+		if (claim?.messages.includes(message)) {
+			queued = true;
+			claim.messages = claim.messages.filter(item => item !== message);
+			this.#cancelQueuedMessagePreparation("steering", true);
+		}
+		for (const delivery of this.#queuedMessageDeliveries) {
+			if (delivery.queue !== "steering") continue;
+			const remaining = delivery.messages.slice(delivery.next).filter(item => item !== message);
+			if (remaining.length === delivery.messages.length - delivery.next) continue;
+			if (remaining.length === 0) this.#queuedMessageDeliveries.delete(delivery);
+			else {
+				delivery.messages = remaining;
+				delivery.next = 0;
+			}
+		}
+		this.#liveSteered = this.#liveSteered.filter(entry => entry.message !== message);
+		this.#notifySteeringWaiters();
+		return queued;
+	}
+
 	/**
 	 * Queue a follow-up message to be processed after the agent finishes.
 	 * Delivered only when agent has no more tool calls or steering messages.
