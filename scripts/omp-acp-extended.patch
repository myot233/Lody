@@ -0,0 +1,48 @@
+import { runOmpManagementMethod } from "./native-management";
+import { commandConsumed, parseSubcommand, usage } from "./helpers/parse";
+import type { SlashCommandSpec } from "./types";
+
+/** The same native operations are callable from ACP and the terminal palette. */
+export const BUILTIN_MANAGEMENT_SLASH_COMMANDS: ReadonlyArray<SlashCommandSpec> = [
+	{
+		name: "omp",
+		description: "Inspect native sessions, projects, usage, extensions, and speech models",
+		allowArgs: true,
+		acpInputHint: "sessions|projects|chats|usage|extensions|extension on|off <provider>|speech-models",
+		handle: async (command, runtime) => {
+			const { verb, rest } = parseSubcommand(command.args);
+			const methods: Record<string, string> = {
+				sessions: "_omp/sessions/listAll",
+				projects: "_omp/projects/list",
+				chats: "_omp/chats/byCwd",
+				usage: "_omp/usage",
+				extensions: "_omp/extensions",
+				"speech-models": "speech.models.list",
+			};
+			let method = methods[verb];
+			const params: Record<string, unknown> = { cwd: runtime.cwd };
+			if (verb === "extension") {
+				const { verb: action, rest: providerId } = parseSubcommand(rest);
+				if ((action !== "on" && action !== "off") || !providerId.trim()) {
+					return usage("Usage: /omp extension on|off <provider>", runtime);
+				}
+				method = "_omp/extensions/toggle";
+				params.providerId = providerId.trim();
+				params.enabled = action === "on";
+			} else if (rest.trim() || !method) {
+				return usage(
+					"Usage: /omp sessions|projects|chats|usage|extensions|extension on|off <provider>|speech-models",
+					runtime,
+				);
+			}
+			await runtime.sessionManager.flush();
+			const result = await runOmpManagementMethod(method, params, runtime.session);
+			if (verb === "extension") {
+				await runtime.settings.flush();
+				await runtime.reloadPlugins();
+			}
+			await runtime.output(JSON.stringify(result));
+			return commandConsumed();
+		},
+	},
+];
diff --git a/packages/coding-agent/src/slash-commands/native-management.ts b/packages/coding-agent/src/slash-commands/native-management.ts
new file mode 100644
index 0000000..5f1ce39
--- /dev/null
+++ b/packages/coding-agent/src/slash-commands/native-management.ts
@@ -0,0 +1,163 @@
+import { type SessionInfo } from "@oh-my-pi/pi-utils/acp";
+import { disableProvider, enableProvider } from "../capability";
+import { Settings } from "../config/settings";
+import { cfgDisabledExtensions } from "../extensibility/settings";
+import { loadAllExtensions } from "../modes/components/extensions/state-manager";
+import type { AgentSession } from "../session/agent-session";
+import type { SessionInfo as StoredSessionInfo } from "../session/session-listing";
+import { SessionManager } from "../session/session-manager";
+import { DEFAULT_STT_MODEL_KEY, STT_MODELS } from "../stt/models";
+import { DEFAULT_TTS_VOICE, TTS_LOCAL_MODELS, TTS_LOCAL_VOICE_OPTIONS } from "../tts/models";
+
+const SPEECH_MODELS_LIST_METHOD = "speech.models.list";
+
+export function toSessionInfo(session: StoredSessionInfo): SessionInfo {
+	return {
+		sessionId: session.id,
+		cwd: session.cwd,
+		title: session.title,
+		updatedAt: session.modified.toISOString(),
+		_meta: { messageCount: session.messageCount, size: session.size },
+	};
+}
+
+type AcpSpeechOption = {
+	value: string;
+	label: string;
+	description?: string;
+};
+
+type AcpSpeechVoiceOption = {
+	value: string;
+	label: string;
+};
+
+type AcpSpeechTtsModelOption = AcpSpeechOption & {
+	voices: AcpSpeechVoiceOption[];
+};
+
+export function buildAcpSpeechModelsCatalog(): Record<string, unknown> {
+	const localSelector = (modelId: string) => `local/${modelId}`;
+	const defaultSpeechModel = localSelector(TTS_LOCAL_MODELS[0].key);
+	const defaultDictationModel = localSelector(DEFAULT_STT_MODEL_KEY);
+	const voices = TTS_LOCAL_VOICE_OPTIONS.map(({ value, label }) => ({ value, label }));
+	return {
+		settings: {
+			speechToTextModel: "modelRoles.dictation",
+			textToSpeechModel: "modelRoles.speech",
+			textToSpeechVoice: "tts.localVoice",
+			speechVoice: "speech.voice",
+		},
+		defaults: {
+			speechToTextModel: defaultDictationModel,
+			textToSpeechModel: defaultSpeechModel,
+			voice: DEFAULT_TTS_VOICE,
+		},
+		speechToText: {
+			setting: "modelRoles.dictation",
+			defaultValue: defaultDictationModel,
+			models: STT_MODELS.map(({ key, label, description }) => ({
+				value: localSelector(key),
+				label,
+				description,
+			})),
+		},
+		textToSpeech: {
+			modelSetting: "modelRoles.speech",
+			voiceSetting: "tts.localVoice",
+			speechVoiceSetting: "speech.voice",
+			defaultModel: defaultSpeechModel,
+			defaultVoice: DEFAULT_TTS_VOICE,
+			models: TTS_LOCAL_MODELS.map(({ key, label, description, voices: modelVoices }): AcpSpeechTtsModelOption => ({
+				value: localSelector(key),
+				label,
+				description,
+				voices: modelVoices.map(({ id, label: voiceLabel }) => ({ value: id, label: voiceLabel })),
+			})),
+			voices,
+		},
+	};
+}
+
+export async function runOmpManagementMethod(
+	method: string,
+	params: Record<string, unknown>,
+	session?: AgentSession,
+): Promise<Record<string, unknown>> {
+	switch (method) {
+		case SPEECH_MODELS_LIST_METHOD:
+			return buildAcpSpeechModelsCatalog();
+		case "_omp/sessions/listAll": {
+			const limit = typeof params.limit === "number" ? Math.max(1, Math.min(5000, params.limit as number)) : 1000;
+			const sessions = await SessionManager.listAll();
+			const sorted = sessions.sort((l, r) => r.modified.getTime() - l.modified.getTime()).slice(0, limit);
+			return {
+				sessions: sorted.map(s => toSessionInfo(s)),
+				total: sessions.length,
+			};
+		}
+		case "_omp/projects/list": {
+			const sessions = await SessionManager.listAll();
+			const buckets = new Map<
+				string,
+				{ cwd: string; sessionCount: number; lastActivityAt: number; lastTitle: string }
+			>();
+			for (const s of sessions) {
+				if (!s.cwd) continue;
+				const ts = s.modified.getTime();
+				const existing = buckets.get(s.cwd);
+				if (existing) {
+					existing.sessionCount += 1;
+					if (ts > existing.lastActivityAt) {
+						existing.lastActivityAt = ts;
+						existing.lastTitle = s.title ?? "";
+					}
+				} else {
+					buckets.set(s.cwd, {
+						cwd: s.cwd,
+						sessionCount: 1,
+						lastActivityAt: ts,
+						lastTitle: s.title ?? "",
+					});
+				}
+			}
+			const projects = Array.from(buckets.values()).sort((a, b) => b.lastActivityAt - a.lastActivityAt);
+			return { projects, totalSessions: sessions.length };
+		}
+		case "_omp/chats/byCwd": {
+			const cwd = typeof params.cwd === "string" ? (params.cwd as string) : undefined;
+			if (!cwd) throw new Error("cwd required");
+			const limit = typeof params.limit === "number" ? Math.max(1, Math.min(500, params.limit as number)) : 100;
+			const sessions = await SessionManager.list(cwd);
+			const sorted = sessions.sort((l, r) => r.modified.getTime() - l.modified.getTime()).slice(0, limit);
+			return { sessions: sorted.map(s => toSessionInfo(s)) };
+		}
+		case "_omp/usage": {
+			const target = session;
+			if (!target) {
+				return { reports: [] };
+			}
+			const reports = await target.fetchUsageReports();
+			return { reports: reports ?? [] };
+		}
+		case "_omp/extensions": {
+			const cwd = typeof params.cwd === "string" ? (params.cwd as string) : undefined;
+			const sm = session?.settings ?? (await Settings.init());
+			const disabledIds = cfgDisabledExtensions.get(sm);
+			const extensions = await loadAllExtensions(cwd, disabledIds);
+			return { extensions: extensions as unknown as Array<{ [key: string]: unknown }> };
+		}
+		case "_omp/extensions/toggle": {
+			const providerId = params.providerId;
+			if (typeof providerId !== "string") throw new Error("providerId required");
+			if (params.enabled === false) {
+				disableProvider(providerId);
+				return { enabled: false };
+			}
+			enableProvider(providerId);
+			return { enabled: true };
+		}
+		default:
+			throw new Error(`Unknown ACP ext method: ${method}`);
+	}
+}
