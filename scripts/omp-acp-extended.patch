+import * as path from "node:path";
+import { runSplitCommit } from "../commit/agentic";
+import { validateSplitCommitPlan } from "../commit/agentic/tools/split-commit";
+import { commandConsumed, parseSubcommand, usage } from "./helpers/parse";
+import type { SlashCommandSpec } from "./types";
+
+export const BUILTIN_COMMIT_SLASH_COMMANDS: ReadonlyArray<SlashCommandSpec> = [
+	{
+		name: "commit-plan",
+		description: "Validate or apply a reviewed atomic commit plan",
+		allowArgs: true,
+		acpInputHint: "validate|apply <plan.json>",
+		handle: async (command, runtime) => {
+			const { verb, rest } = parseSubcommand(command.args);
+			if ((verb !== "validate" && verb !== "apply") || !rest.trim())
+				return usage("Usage: /commit-plan validate|apply <plan.json>", runtime);
+			runtime.signal?.throwIfAborted();
+			const input: unknown = await Bun.file(path.resolve(runtime.cwd, rest.trim())).json();
+			const validation = await validateSplitCommitPlan(runtime.cwd, input);
+			const result = validation.details;
+			if (!result) throw new Error("Commit plan validation did not return a result");
+			if (verb === "validate" || !result.valid || !result.proposal) {
+				await runtime.output(JSON.stringify(result));
+				return commandConsumed();
+			}
+			const confirm = runtime.confirm;
+			if (!confirm) return usage("Commit plan requires an operator confirmation supported by this client.", runtime);
+			await runSplitCommit(result.proposal, {
+				cwd: runtime.cwd,
+				dryRun: false,
+				push: false,
+				signal: runtime.signal,
+				output: runtime.output,
+				confirm: plan => confirm("Apply atomic commit plan", JSON.stringify(plan, null, 2)),
+			});
+			return commandConsumed();
+		},
+	},
+];
diff --git a/packages/coding-agent/src/slash-commands/builtin-management.ts b/packages/coding-agent/src/slash-commands/builtin-management.ts
