+import * as path from "node:path";
+import { getConfigRootDir } from "@oh-my-pi/pi-utils";
+import type { ImageContent } from "@oh-my-pi/pi-ai";
+import { importRoomKey } from "../../collab/crypto";
+import { CollabHost, type CollabHostContext } from "../../collab/host";
+import {
+	COLLAB_PROTO,
+	DEFAULT_RELAY_URL,
+	parseCollabLink,
+	type CollabFrame,
+	type CollabSessionState,
+} from "../../collab/protocol";
+import { CollabSocket } from "../../collab/relay-client";
+import type { AgentSession, AgentSessionEvent } from "../../session/agent-session";
+import { SessionManager } from "../../session/session-manager";
+import type { SessionEntry, SessionHeader } from "../../session/session-entries";
+
+function previewEntry(entry: SessionEntry) {
+	const content =
+		entry.type === "message" && "content" in entry.message
+			? entry.message.content
+			: entry.type === "custom_message"
+				? entry.content
+				: undefined;
+	const text =
+		typeof content === "string"
+			? content
+			: (content
+					?.flatMap(block => (block.type === "text" ? [block.text.slice(0, 256)] : []))
+					.slice(0, 4)
+					.join("\n") ?? "");
+	return { id: entry.id, type: entry.type, text: text.slice(0, 1024) };
+}
+
+/** Owns native encrypted collaboration independently of terminal presentation. */
+export class AcpCollaboration {
+	#host: CollabHost | undefined;
+	#socket: CollabSocket | undefined;
+	#replica: SessionManager | undefined;
+	#state: CollabSessionState | undefined;
+	#readOnly = true;
+	#watching = false;
+	#preview: Array<{ id: string; type: SessionEntry["type"]; text: string }> = [];
+	#entryCount = 0;
+	#pendingRemote: { resolve(): void; reject(error: unknown): void } | undefined;
+	constructor(
+		readonly session: AgentSession,
+		readonly onRemoteEvent: (event: AgentSessionEvent) => void,
+	) {}
+	get joined(): boolean {
+		return this.#replica !== undefined && this.#socket !== undefined;
+	}
+
+	async command(
+		name: string,
+		args: string,
+		signal?: AbortSignal,
+		onWatchReady?: () => Promise<void>,
+	): Promise<unknown> {
+		const [verb, ...rest] = args.trim().split(/\s+/);
+		if (name === "join") return this.#join(args.trim(), signal);
+		if (name === "leave") {
+			await this.dispose();
+			return { role: "local" };
+		}
+		if (name !== "collab") throw new Error("Unknown collaboration command");
+		if (verb === "stop") {
+			await this.#host?.stop("sharing stopped");
+			this.#host = undefined;
+			return { role: "local" };
+		}
+		if (verb === "status") return this.#status();
+		if (verb === "watch") {
+			if (!this.#host || this.#host.ending) throw new Error("Start sharing before /collab watch");
+			this.#watching = true;
+			const waiting = Promise.withResolvers<void>();
+			const unsubscribe = this.session.subscribe(event => {
+				if (event.type === "agent_end") waiting.resolve();
+			});
+			const onAbort = () => waiting.reject(signal?.reason);
+			signal?.addEventListener("abort", onAbort, { once: true });
+			try {
+				signal?.throwIfAborted();
+				await onWatchReady?.();
+				await waiting.promise;
+			} finally {
+				this.#watching = false;
+				unsubscribe();
+				signal?.removeEventListener("abort", onAbort);
+			}
+			return undefined;
+		}
+		if (verb && verb !== "start" && verb !== "view")
+			throw new Error("Usage: /collab start|view|status|watch|stop [relayUrl]");
+		if (this.joined) throw new Error("Leave the remote session before hosting");
+		if (!this.#host || this.#host.ending) {
+			const context: CollabHostContext = {
+				session: this.session,
+				sessionManager: this.session.sessionManager,
+				settings: this.session.settings,
+				eventBus: undefined,
+				subagentEventBus: undefined,
+				collabHost: undefined,
+				showStatus: message => this.session.emitNotice("info", message, "collab"),
+				updatePendingMessagesDisplay() {},
+				ui: { requestRender() {} },
+				statusLine: {
+					setCollabStatus() {},
+					invalidate() {},
+					getCachedContextBreakdown: () => {
+						const usage = this.session.getContextUsage();
+						return {
+							usedTokens: usage?.tokens,
+							contextWindow: usage?.contextWindow ?? this.session.model?.contextWindow ?? 0,
+						};
+					},
+				},
+			};
+			const host = new CollabHost(context, { guestActionsReady: () => this.#watching });
+			context.collabHost = host;
+			this.#host = host;
+			const onAbort = () => {
+				void host.stop("start cancelled");
+			};
+			signal?.addEventListener("abort", onAbort, { once: true });
+			try {
+				signal?.throwIfAborted();
+				await host.start(rest.join(" ") || DEFAULT_RELAY_URL);
+			} catch (error) {
+				await host.stop("start failed");
+				this.#host = undefined;
+				throw error;
+			} finally {
+				signal?.removeEventListener("abort", onAbort);
+			}
+		}
+		return { ...this.#status(), link: verb === "view" ? this.#host.viewLink : this.#host.link };
+	}
+
+	#status() {
