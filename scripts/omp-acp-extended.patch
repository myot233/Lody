+							);
+							await replica.setSessionFile(replicaPath);
+							if (this.#socket !== socket) {
+								await replica.close();
+								return;
+							}
+							this.#preview = pending.entries.slice(-20).map(previewEntry);
+							this.#entryCount = pending.count;
+							this.#replica = replica;
+							pending = undefined;
+							ready.resolve();
+						}
+						return;
+					}
+					await this.#receive(frame, fail);
+				})
+				.catch(error => {
+					fail(error);
+					socket.close();
+					if (this.#socket === socket) this.#socket = undefined;
+				});
+		};
+		const onAbort = () => {
+			fail(signal?.reason);
+			socket.close();
+			this.#socket = undefined;
+		};
+		signal?.addEventListener("abort", onAbort, { once: true });
+		const timeout = setTimeout(() => fail(new Error("Collaboration join timed out")), 30_000);
+		try {
+			signal?.throwIfAborted();
+			socket.connect();
+			await ready.promise;
+			return this.#status();
+		} catch (error) {
+			socket.close();
+			this.#socket = undefined;
+			await this.#replica?.close();
+			this.#replica = undefined;
+			throw error;
+		} finally {
+			clearTimeout(timeout);
+			signal?.removeEventListener("abort", onAbort);
+		}
+	}
+
+	async #receive(frame: CollabFrame, fail: (error: unknown) => void): Promise<void> {
+		if (frame.t === "entry") {
+			if (this.#replica && !this.#replica.getEntry(frame.entry.id)) {
+				this.#replica.ingestReplicatedEntry(frame.entry);
+				this.#entryCount++;
+				this.#preview = [...this.#preview.slice(-19), previewEntry(frame.entry)];
+			}
+			return;
+		}
+		if (frame.t === "state") {
+			this.#state = frame.state;
+			return;
+		}
+		if (frame.t === "event" && this.#pendingRemote) {
+			this.onRemoteEvent(frame.event);
+			if (frame.event.type === "agent_end") {
+				this.#pendingRemote.resolve();
+				this.#pendingRemote = undefined;
+			}
+			return;
+		}
+		if (frame.t === "error") {
+			fail(new Error(frame.message));
+			return;
+		}
+		if (frame.t === "bye") {
+			fail(new Error(frame.reason));
+			await this.dispose();
+		}
+	}
+
+	async prompt(text: string, images: ImageContent[], signal?: AbortSignal): Promise<void> {
+		if (!this.joined || !this.#socket) throw new Error("Remote session is disconnected");
+		if (this.#readOnly) throw new Error("This collaboration link is read-only");
+		if (this.#pendingRemote) throw new Error("Remote prompt is already active");
+		const completion = Promise.withResolvers<void>();
+		this.#pendingRemote = completion;
+		const onAbort = () => {
+			this.#socket?.send({ t: "abort" });
+			completion.reject(signal?.reason);
+			this.#pendingRemote = undefined;
+		};
+		signal?.addEventListener("abort", onAbort, { once: true });
+		try {
+			signal?.throwIfAborted();
+			this.#socket.send({ t: "prompt", text, images });
+			await completion.promise;
+		} finally {
+			signal?.removeEventListener("abort", onAbort);
+			if (this.#pendingRemote === completion) this.#pendingRemote = undefined;
+		}
+	}
+
+	async dispose(): Promise<void> {
+		this.#pendingRemote?.reject(new Error("Left remote session"));
+		this.#pendingRemote = undefined;
+		this.#socket?.close();
+		this.#socket = undefined;
+		await this.#replica?.close();
+		this.#replica = undefined;
+		await this.#host?.stop("ACP session closed");
+		this.#host = undefined;
+	}
+}
diff --git a/packages/coding-agent/src/modes/acp/acp-components.ts b/packages/coding-agent/src/modes/acp/acp-components.ts
new file mode 100644
index 0000000..1c259bd
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/acp-components.ts
@@ -0,0 +1,194 @@
+import { TUI, type Terminal } from "@oh-my-pi/pi-tui";
+import { KeybindingsManager } from "@oh-my-pi/pi-tui/app-keybindings";
+import { ensureThemeSync, getCurrentThemeName, theme, type Theme } from "@oh-my-pi/pi-tui/theme";
+import type { AgentSideConnection } from "@oh-my-pi/pi-utils/acp";
+import type { LodyComponentDocument, LodyComponentEvent, LodyElicitationMeta } from "acp-extension-core";
+import { z } from "zod";
+import type {
+	ExtensionCustomOptions,
+	ExtensionUIContext,
+	ExtensionUiComponent,
+} from "../../extensibility/extensions/types";
+
+/** An in-memory component host: ACP stdout always remains a JSON-RPC stream. */
+class ComponentTerminal implements Terminal {
+	columns = 80;
+	rows = 24;
+	kittyProtocolActive = false;
+	kittyEnableSequence = null;
+	appearance = undefined;
+	start(): void {}
+	stop(): void {}
+	write(): void {}
+	moveBy(): void {}
+	hideCursor(): void {}
+	showCursor(): void {}
+	clearLine(): void {}
+	clearFromCursor(): void {}
+	clearScreen(): void {}
+	setTitle(): void {}
+	setProgress(): void {}
+	onAppearanceChange(): void {}
+	async drainInput(): Promise<void> {}
+}
+class ComponentTui extends TUI {
+	override requestRender(): void {}
+}
+
+function keyInput(key: string): string | undefined {
+	const special: Record<string, string> = {
+		up: "\x1b[A",
+		down: "\x1b[B",
+		left: "\x1b[D",
+		right: "\x1b[C",
+		enter: "\r",
+		escape: "\x1b",
+		esc: "\x1b",
+		tab: "\t",
+		space: " ",
+		backspace: "\x7f",
+	};
+	if (special[key]) return special[key];
+	if (key.length === 1) return key;
+	// CSI-u preserves Ctrl+I/J/M instead of collapsing them to Tab/Enter.
+	if (/^ctrl\+[a-z]$/.test(key)) return `\x1b[${key.charCodeAt(5)};5u`;
+	return undefined;
+}
+const eventSchema: z.ZodType<LodyComponentEvent> = z
+	.object({
+		version: z.literal(1),
+		componentId: z.string().min(1).max(128),
+		revision: z.number().int().nonnegative(),
+		input: z.string().max(4096),
+	})
+	.strict();
+
+/** Present a native custom component through negotiated, inert Core GUI documents. */
+export function createAcpComponentPresenter(
+	connection: AgentSideConnection,
+	getSessionId: () => string,
+	getTurnSignal: () => AbortSignal | undefined,
+): ExtensionUIContext["custom"] {
+	return async <T>(
+		factory: (
+			tui: TUI,
+			theme: Theme,
+			keybindings: KeybindingsManager,
+			done: (result: T) => void,
+		) => ExtensionUiComponent | Promise<ExtensionUiComponent>,
+		options?: ExtensionCustomOptions,
+	): Promise<T> => {
+		const turnSignal = getTurnSignal();
+		const signal = AbortSignal.any([
+			connection.signal,
+			...(options?.signal ? [options.signal] : []),
+			...(turnSignal ? [turnSignal] : []),
+		]);
+		signal.throwIfAborted();
+		ensureThemeSync();
+		const tui = new ComponentTui(new ComponentTerminal(), false);
+		const keybindings = KeybindingsManager.create();
+		let done = false;
+		let result: T | undefined;
+		const completion = Promise.withResolvers<void>();
+		const aborted = Promise.withResolvers<never>();
+		const onAbort = () => aborted.reject(signal.reason);
+		signal.addEventListener("abort", onAbort, { once: true });
+		// Observe rejection even when the factory fails before the first frame.
+		void aborted.promise.catch(() => {});
+		let component: ExtensionUiComponent | undefined;
+		const id = crypto.randomUUID();
+		let revision = 0;
+		try {
+			component = await Promise.race([
+				Promise.resolve(
+					factory(tui, theme, keybindings, value => {
+						done = true;
+						result = value;
+						completion.resolve();
+					}),
+				).then(created => {
+					if (signal.aborted) {
+						created.dispose?.();
+						signal.throwIfAborted();
+					}
+					return created;
+				}),
+				aborted.promise,
+			]);
+			while (!done) {
+				const bindings = (
+					["tui.select.up", "tui.select.down", "tui.select.confirm", "tui.select.cancel"] as const
+				).flatMap(action =>
+					keybindings.getKeys(action).flatMap(key => {
+						const input = keyInput(key);
+						return input === undefined
+							? []
+							: [
+									{
+										key: key.replace("escape", "esc"),
+										label: keybindings.getDefinition(action).description ?? action,
+										input,
+									},
+								];
+					}),
+				);
+				const lines = component
+					.render(80)
+					.map(line => Bun.stripANSI(line).replace(/[\x00-\x08\x0b-\x1f\x7f-\x9f]/g, ""));
+				if (lines.length > 128 || lines.join("\n").length > 65_536)
+					throw new Error("Custom component exceeds ACP frame limit");
+				const document: LodyComponentDocument = {
+					version: 1,
+					id,
+					revision,
+					title: "Agent component",
+					theme: {
+						name: getCurrentThemeName() ?? "dark",
+						foreground: theme.getColorHex("text"),
+						background: theme.getBgHex("userMessageBg"),
+						accent: theme.getColorHex("accent"),
+					},
+					nodes: [
+						{ type: "text", text: lines.join("\n") },
+						...bindings.map((binding, index) => ({
+							type: "button" as const,
+							id: `key-${index}`,
+							label: binding.label,
+							input: binding.input,
+						})),
+						{ type: "input", id: "text", label: "Text input" },
+					],
+					keybindings: bindings,
+				};
+				const metadata: LodyElicitationMeta = { version: 1, component: document };
+				if (bindings.length > 128 || Buffer.byteLength(JSON.stringify(document)) > 131_072)
+					throw new Error("Custom component exceeds ACP document limit");
+				const response = await Promise.race([
+					connection.unstable_createElicitation({
+						mode: "form",
+						sessionId: getSessionId(),
+						message: document.title,
+						requestedSchema: { type: "object", properties: { event: { type: "string" } }, required: ["event"] },
+						_meta: { lody: { elicitation: metadata } },
+					}),
+					completion.promise.then(() => undefined),
+					aborted.promise,
+				]);
+				if (done) break;
+				if (!response) return undefined as T;
+				if (response.action !== "accept" || typeof response.content?.event !== "string") return undefined as T;
+				const event = eventSchema.parse(JSON.parse(response.content.event));
+				if (event.componentId !== id || event.revision !== revision)
+					throw new Error("Stale or foreign component input");
+				component.handleInput?.(event.input);
+				revision++;
+			}
+			return result as T;
+		} finally {
+			signal.removeEventListener("abort", onAbort);
+			component?.dispose?.();
+			tui.stop();
+		}
+	};
+}
