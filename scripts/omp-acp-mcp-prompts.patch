diff --git a/packages/coding-agent/src/mcp/prompt-commands.ts b/packages/coding-agent/src/mcp/prompt-commands.ts
new file mode 100644
index 0000000..cf062ef
--- /dev/null
+++ b/packages/coding-agent/src/mcp/prompt-commands.ts
@@ -0,0 +1,53 @@
+import type { LoadedCustomCommand } from "../extensibility/custom-commands";
+import type { MCPManager } from "./manager";
+
+/**
+ * Build LoadedCustomCommand entries for all MCP prompts across connected servers.
+ * These are re-created whenever prompts change (setOnPromptsChanged callback).
+ */
+export function buildMCPPromptCommands(
+	manager: Pick<MCPManager, "getConnectedServers" | "getServerPrompts" | "executePrompt">,
+): LoadedCustomCommand[] {
+	const commands: LoadedCustomCommand[] = [];
+	for (const serverName of manager.getConnectedServers()) {
+		const prompts = manager.getServerPrompts(serverName);
+		if (!prompts?.length) continue;
+		for (const prompt of prompts) {
+			const commandName = `${serverName}:${prompt.name}`;
+			commands.push({
+				path: `mcp:${commandName}`,
+				resolvedPath: `mcp:${commandName}`,
+				source: "bundled",
+				command: {
+					name: commandName,
+					description: prompt.description ?? `MCP prompt from ${serverName}`,
+					async execute(args: string[]) {
+						const promptArgs: Record<string, string> = {};
+						for (const arg of args) {
+							const eqIdx = arg.indexOf("=");
+							if (eqIdx > 0) {
+								promptArgs[arg.slice(0, eqIdx)] = arg.slice(eqIdx + 1);
+							}
+						}
+						const result = await manager.executePrompt(serverName, prompt.name, promptArgs);
+						if (!result) return "";
+						const parts: string[] = [];
+						for (const msg of result.messages) {
+							const contentItems = Array.isArray(msg.content) ? msg.content : [msg.content];
+							for (const item of contentItems) {
+								if (item.type === "text") {
+									parts.push(item.text);
+								} else if (item.type === "resource") {
+									const resource = item.resource;
+									if (resource.text) parts.push(resource.text);
+								}
+							}
+						}
+						return parts.join("\n\n");
+					},
+				},
+			});
+		}
+	}
+	return commands;
+}
diff --git a/packages/coding-agent/test/mcp-prompt-commands.test.ts b/packages/coding-agent/test/mcp-prompt-commands.test.ts
new file mode 100644
index 0000000..843bcc0
--- /dev/null
+++ b/packages/coding-agent/test/mcp-prompt-commands.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from "bun:test";
+import type { CustomCommandContext } from "../src/extensibility/custom-commands";
+import type { MCPManager } from "../src/mcp/manager";
+import { buildMCPPromptCommands } from "../src/mcp/prompt-commands";
+
+describe("MCP prompt slash commands", () => {
+	const context = {} as CustomCommandContext;
+	it("preserves server namespaces, arguments and textual prompt content", async () => {
+		const calls: Array<{ server: string; prompt: string; args?: Record<string, string> }> = [];
+		const manager: Pick<MCPManager, "getConnectedServers" | "getServerPrompts" | "executePrompt"> = {
+			getConnectedServers: () => ["first", "second", "empty"],
+			getServerPrompts: server =>
+				server === "empty" ? undefined : [{ name: "review", description: "Review a topic" }],
+			async executePrompt(server, prompt, args) {
+				calls.push({ server, prompt, args });
+				return {
+					messages: [
+						{ role: "user", content: { type: "text", text: "Prompt text" } },
+						{
+							role: "user",
+							content: { type: "resource", resource: { uri: "fixture://topic", text: "Resource text" } },
+						},
+						{ role: "user", content: { type: "image", data: "fixture", mimeType: "image/png" } },
+					],
+				};
+			},
+		};
+		const commands = buildMCPPromptCommands(manager);
+		expect(commands.map(entry => entry.command.name)).toEqual(["first:review", "second:review"]);
+		expect(commands[0]?.command.description).toBe("Review a topic");
+		expect(await commands[1]!.command.execute(["topic=a=b", "empty=", "ignored"], context)).toBe(
+			"Prompt text\n\nResource text",
+		);
+		expect(calls).toEqual([{ server: "second", prompt: "review", args: { topic: "a=b", empty: "" } }]);
+	});
+
+	it("handles a prompt server disappearing before invocation", async () => {
+		const manager: Pick<MCPManager, "getConnectedServers" | "getServerPrompts" | "executePrompt"> = {
+			getConnectedServers: () => ["fixture"],
+			getServerPrompts: () => [{ name: "review" }],
+			async executePrompt() {
+				return undefined;
+			},
+		};
+		const [command] = buildMCPPromptCommands(manager);
+		expect(command?.command.description).toBe("MCP prompt from fixture");
+		expect(await command!.command.execute([], context)).toBe("");
+	});
+});
